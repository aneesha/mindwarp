{
  "name": "mindwarp",
  "version": "0.1.0",
  "description": "In-browser mindmapping canvas with integrated small language model",
  "type": "module",
  "main": "dist/mindwarp.umd.js",
  "module": "dist/mindwarp.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build:lib": "vite build && tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "build:docs": "vite build --config vite.config.docs.ts",
    "build": "npm run build:lib && npm run build:docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "preview": "vite preview"
  },
  "keywords": [
    "mindmap",
    "ai",
    "transformers",
    "webgpu",
    "browser"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.4.0",
    "docx": "^9.0.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.10.0",
    "html-to-image": "^1.11.0",
    "marked": "^15.0.0",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "jsdom": "^28.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
